// Yola database schema (PostgreSQL).
//
// Conventions
// - IDs are prefixed random strings generated by the application (pay_, proj_, key_ ...).
// - Money is stored as BigInt zatoshis. Never floats.
// - Every tenant-owned row carries projectId, and every query filters by it.
// - Secrets are stored hashed (API keys) or encrypted (webhook secrets, viewing keys).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Authentication (Better Auth core tables) ─────────────────────────

model User {
  id            String          @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  memberships   ProjectMember[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

// ── Projects ─────────────────────────────────────────────────────────

enum Network {
  demo
  testnet
  mainnet
}

enum ProjectRole {
  owner
  developer
}

model Project {
  id             String  @id
  name           String
  description    String?
  defaultNetwork Network @default(demo)
  /// Confirmations a testnet payment needs before it is confirmed.
  testnetConfirmations Int @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members          ProjectMember[]
  apiKeys          ApiKey[]
  payments         PaymentRequest[]
  webhookEndpoints WebhookEndpoint[]
  viewingKeys      ViewingKey[]

  @@map("project")
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

// ── API keys ─────────────────────────────────────────────────────────

enum ApiKeyMode {
  test
  live
}

model ApiKey {
  id          String     @id
  projectId   String
  name        String
  mode        ApiKeyMode
  /// SHA-256 (hex) of the full secret. The secret itself is never stored.
  secretHash  String     @unique
  /// Last four characters, for recognising a key in lists.
  last4       String
  createdById String?
  createdAt   DateTime   @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_key")
}

// ── Payments ─────────────────────────────────────────────────────────

enum TrustLevel {
  simulated
  verified_testnet
  verified_mainnet
}

enum PaymentStatus {
  created
  awaiting_payment
  payment_detected
  confirming
  confirmed
  expired
  cancelled
  failed
  underpaid
  overpaid
  verification_required
}

model PaymentRequest {
  id                     String        @id
  projectId              String
  network                Network
  trustLevel             TrustLevel
  amountZatoshis         BigInt
  currency               String        @default("ZEC")
  destination            String
  description            String?
  externalReference      String?
  metadata               Json          @default("{}")
  status                 PaymentStatus
  paymentUri             String?
  qrPayload              String
  confirmationsObserved  Int?
  confirmationsRequired  Int?
  amountReceivedZatoshis BigInt?
  transactionId          String?
  /// For testnet/mainnet: diversifier index of the per-request address.
  diversifierIndex       Decimal?      @db.Decimal(39, 0)
  expiresAt              DateTime
  createdAt              DateTime
  updatedAt              DateTime
  /// Optimistic concurrency: every write must name the version it read.
  version                Int           @default(0)

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events       PaymentEvent[]
  observations PaymentObservation[]

  @@unique([projectId, network, diversifierIndex])
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([projectId, status])
  @@index([projectId, externalReference])
  @@index([status, expiresAt])
  @@map("payment_request")
}

/// Append-only status history. One row per transition.
model PaymentEvent {
  paymentRequestId String
  seq              Int
  status           PaymentStatus
  evidence         String
  note             String?
  at               DateTime
  payment          PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@id([paymentRequestId, seq])
  @@map("payment_event")
}

enum ShieldedPool {
  orchard
  sapling
  /// NU6.3 pool. Shares Orchard's keys and addresses; notes use plaintext version 3.
  ironwood
  transparent
}

/// An output the verification backend saw paying a request's address.
/// Unique per output, so observing the same output twice changes nothing.
model PaymentObservation {
  id               String         @id
  paymentRequestId String
  projectId        String
  network          Network
  txid             String
  pool             ShieldedPool
  outputIndex      Int
  valueZatoshis    BigInt
  /// Null while the transaction is only in the mempool.
  blockHeight      Int?
  blockHash        String?
  observedAt       DateTime       @default(now())
  /// Set when a reorg removed the transaction from the best chain.
  invalidatedAt    DateTime?
  payment          PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@unique([network, txid, pool, outputIndex])
  @@index([paymentRequestId])
  @@map("payment_observation")
}

/// Encrypted incoming viewing key used to derive addresses and detect payments.
model ViewingKey {
  id                   String   @id
  projectId            String
  network              Network
  /// AES-256-GCM ciphertext (base64) of the UIVK. Never returned by any API.
  encryptedKey         String
  /// SHA-256 prefix of the key, to recognise it without decrypting.
  fingerprint          String
  nextDiversifierIndex Decimal  @default(0) @db.Decimal(39, 0)
  birthdayHeight       Int?
  createdAt            DateTime @default(now())
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, network])
  @@map("viewing_key")
}

// ── Idempotency ──────────────────────────────────────────────────────

model IdempotencyRecord {
  projectId    String
  key          String
  fingerprint  String
  /// Null while the original request is still running.
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@id([projectId, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}

// ── Webhooks ─────────────────────────────────────────────────────────

model WebhookEndpoint {
  id              String    @id
  projectId       String
  url             String
  description     String?
  /// AES-256-GCM ciphertext of the signing secret.
  secretEncrypted String
  /// Event types delivered to this endpoint. Empty means all.
  eventTypes      String[]
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([projectId])
  @@map("webhook_endpoint")
}

model WebhookEvent {
  id               String   @id
  projectId        String
  type             String
  paymentRequestId String?
  /// Exact JSON body delivered (and signed).
  payload          Json
  createdAt        DateTime @default(now())
  deliveries       WebhookDelivery[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([paymentRequestId])
  @@map("webhook_event")
}

enum DeliveryStatus {
  pending
  delivering
  succeeded
  failed
}

model WebhookDelivery {
  id             String         @id
  eventId        String
  endpointId     String
  projectId      String
  status         DeliveryStatus @default(pending)
  attemptCount   Int            @default(0)
  nextAttemptAt  DateTime       @default(now())
  /// Lease: a worker owns the delivery until this time.
  lockedUntil    DateTime?
  lastStatusCode Int?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  event          WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts       WebhookAttempt[]

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("webhook_delivery")
}

model WebhookAttempt {
  id          String          @id
  deliveryId  String
  attempt     Int
  startedAt   DateTime
  durationMs  Int
  statusCode  Int?
  /// Short error description. Never contains the payload or secrets.
  error       String?
  delivery    WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("webhook_attempt")
}

// ── Operations ───────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id
  projectId  String?
  actorType  String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  /// Non-sensitive context only (no secrets, keys, memos or customer data).
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@map("audit_event")
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_bucket")
}

/// Scanner progress per network. One row per network; the lease columns make
/// sure only one server instance scans at a time.
model ChainCursor {
  network         Network   @id
  /// Last block scanned (inclusive) and its hash, for reorg detection.
  height          Int
  hash            String
  /// Start time of the last complete pass (blocks up to the tip, then the mempool).
  /// A testnet request only expires once a complete pass that began after its
  /// deadline has found nothing, so a slow scanner can never expire a paid request.
  observedThrough DateTime?
  lockedUntil     DateTime?
  lockOwner       String?
  updatedAt       DateTime  @updatedAt

  @@map("chain_cursor")
}

/// Recent block hashes, so a reorg can be traced back to the fork point.
model ChainBlock {
  network  Network
  height   Int
  hash     String
  prevHash String
  time     DateTime

  @@id([network, height])
  @@map("chain_block")
}
