# Yola server environment. Copy to .env.local for development.
# Never commit real values. Everything here is read on the server only:
# nothing is exposed to browsers (no NEXT_PUBLIC_ variables are used).
#
# Without DATABASE_URL the marketing site, docs, playground and sample
# store still work; the API, dashboard and background jobs are disabled.

# ── Required ─────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres@localhost:5432/yola

# Signs session cookies. 32+ random characters: openssl rand -base64 32
YOLA_SESSION_SECRET=

# Encrypts webhook signing secrets and viewing keys at rest.
# Exactly 32 random bytes, base64: openssl rand -base64 32
YOLA_ENCRYPTION_KEY=

# Public base URL. Must be https:// in production (http allowed for localhost).
YOLA_PUBLIC_APP_URL=http://localhost:3000

# ── Networks ─────────────────────────────────────────────────────────
# demo | testnet (mainnet is rejected in this release)
YOLA_DEFAULT_NETWORK=demo
# true only after the scanner below is running against a testnet lightwalletd/Zaino server.
YOLA_TESTNET_ENABLED=false
# Must stay false: the mainnet verification path has not been built or reviewed.
YOLA_MAINNET_ENABLED=false

# ── Zcash testnet backend (server-side only) ─────────────────────────
# URL of the Yola scanner (scanner/, see docs/TESTNET.md), not of the node.
# Required when testnet is enabled. Keep the scanner on a private network.
ZCASH_BACKEND_URL=
# The scanner's YOLA_SCANNER_TOKEN. 32+ characters: openssl rand -hex 32
ZCASH_BACKEND_AUTH_TOKEN=

# ── Background jobs (webhook delivery, expiry sweep) ─────────────────
# inline: the web server runs the job loop (single server or VM)
# cron:   an external scheduler POSTs /api/internal/jobs every minute
# off:    no jobs (not recommended)
YOLA_JOBS_MODE=inline
# Required for cron mode. 32+ random characters.
YOLA_CRON_SECRET=

# ── Network trust ────────────────────────────────────────────────────
# Set true only behind a reverse proxy that sets X-Forwarded-For.
YOLA_TRUST_PROXY=false
# Comma-separated proxy IPs/CIDRs, e.g. 10.0.0.0/24 (used with YOLA_TRUST_PROXY).
YOLA_TRUSTED_PROXIES=

# ── Optional sign-in with GitHub ─────────────────────────────────────
# Callback URL: <YOLA_PUBLIC_APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Development only (rejected when NODE_ENV=production) ─────────────
# Allow webhook URLs on localhost/private networks for local testing.
YOLA_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Disable API and sign-in rate limits.
YOLA_DISABLE_RATE_LIMIT=false

# debug | info | warn | error
LOG_LEVEL=info
