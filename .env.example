# Yola environment. Copy to .env.local. Never commit real values.
# Stage 1 (landing page + simulator) needs none of these.

# ── Required from Stage 3 ──────────────────────────────
DATABASE_URL=                  # postgres://user:pass@host:5432/yola
YOLA_SESSION_SECRET=           # 32+ random bytes, base64
YOLA_ENCRYPTION_KEY=           # 32 random bytes, base64. Encrypts viewing keys at rest.
YOLA_WEBHOOK_SIGNING_SECRET=   # default signing secret for webhook endpoints
YOLA_PUBLIC_APP_URL=http://localhost:3000

# ── Networks ───────────────────────────────────────────
YOLA_DEFAULT_NETWORK=demo      # demo | testnet | mainnet
YOLA_TESTNET_ENABLED=false     # true only after the backend below is configured and checked
YOLA_MAINNET_ENABLED=false     # keep false until verification has been tested and reviewed

# ── Zcash backend (Stage 4, server-side only) ──────────
ZCASH_BACKEND_URL=             # Zaino endpoint in front of a Zebra node
ZCASH_BACKEND_AUTH_TOKEN=
